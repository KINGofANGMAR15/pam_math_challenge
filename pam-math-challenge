#!/bin/sh
# pam-math-challenge — включение/отключение челленджа в PAM-стеках.
#
# Патчит не только lightdm, но и ЛЮБОЙ обнаруженный стек, через который
# реально проходит вход/разблокировка экрана:
#
#   менеджеры входа:    lightdm (/etc/pam.d), plasmalogin (/usr/lib/pam.d)
#   экраны блокировки:  kde (KDE Plasma / kscreenlocker), xfce4-screensaver,
#                       light-locker, xscreensaver, gnome-screensaver,
#                       mate-screensaver, cinnamon-screensaver
#
# Для файлов из /usr/lib/pam.d (owned пакетами) создаются OVERRIDE в
# /etc/pam.d/<имя> — man 8 pam: "All files in /etc/pam.d/ override files with
# the same name in other directories". Файлы пакетов при этом не трогаются,
# pacman-обновления их перетирают безопасно; регенерация — `refresh`.
#
# Использование:
#   pam-math-challenge enable     — подключить во все найденные стеки
#   pam-math-challenge disable    — отключить отовсюду
#   pam-math-challenge status     — что найдено / активно
#   pam-math-challenge refresh    — регенерировать override'ы после
#                                   обновления пакетов (Plasma и т.п.)
#   pam-math-challenge restart    — перезапуск display manager
#
# Требует root; запускать из tty/ssh-сессии.

set -u

PAM_NAME="pam_math_challenge"
CONF_PATH="/etc/security/math_challenge.conf"
ETC_PAM="/etc/pam.d"
VENDOR_PAM="/usr/lib/pam.d"

# Сервисы, связанные с входом и экраном блокировки. autologin-файлы
# НЕ патчим: там нет проверки пароля, челлендж просто сломает автологин.
LOGIN_SERVICES="lightdm plasmalogin"
LOCK_SERVICES="kde xfce4-screensaver light-locker xscreensaver gnome-screensaver mate-screensaver cinnamon-screensaver"

# Одно-промптовые greeter'ы (не рендерят вторые PAM-промпты): модуль должен
# идти ПЕРВЫМ в auth-стеке (combined "пароль:ответ" до pam_unix).
SINGLE_PROMPT_SERVICES="kde plasmalogin"

MARKER="# pam-math-challenge override (генерируется helper'ом)"

msg()   { printf '%s\n' "$*"; }
ok()    { printf '[+] %s\n' "$*"; }
warn()  { printf '[!] %s\n' "$*" >&2; }
die()   { printf '[x] %s\n' "$*" >&2; exit 1; }

need_root() {
    [ "$(id -u)" -eq 0 ] || die "требуется root (sudo pam-math-challenge $1)"
}

# ---- обнаружение сервисов в /etc/pam.d и /usr/lib/pam.d ----

find_service_files() {
    for base in "$ETC_PAM" "$VENDOR_PAM"; do
        for name in $LOGIN_SERVICES $LOCK_SERVICES; do
            [ -f "$base/$name" ] && echo "$base/$name"
        done
    done
}

line_exists() {
    grep -qE "^[[:space:]]*auth[[:space:]]+[^#]*${PAM_NAME}\.so" "$1" 2>/dev/null
}

# номер строки ПОСЛЕ которой вставлять (= последняя auth-строка), 0 если нет
last_auth_line() {
    awk '$1=="auth" || $1=="-auth" {n=NR} END{print n+0}' "$1"
}

# Вставить строку ПОСЛЕ последнего auth-правила (multi-prompt greeter'ы).
# Второй параметр "nomarker" — не добавлять маркер (для обычных /etc-файлов).
insert_after_last_auth() {
    file="$1"
    tmp="$(mktemp)"
    n=$(last_auth_line "$file")
    if [ "$n" -gt 0 ]; then
        awk -v n="$n" -v line="auth optional ${PAM_NAME}.so" \
            'NR==n{print; print line; next} {print}' "$file" > "$tmp"
    else
        { cat "$file"; printf 'auth optional %s.so\n' "$PAM_NAME"; } > "$tmp"
    fi
    [ "${2:-}" = "nomarker" ] || printf '\n%s\n' "$MARKER" >> "$tmp"
    chmod --reference="$file" "$tmp" 2>/dev/null || chmod 0644 "$tmp"
    mv "$tmp" "$file"
}

# Вставить строку ПЕРЕД первым auth-правилом (одно-промптовые greeter'ы:
# модуль собеседует ДО pam_unix и кладёт ПАРОЛЬ в PAM_AUTHTOK).
insert_before_first_auth() {
    file="$1"
    tmp="$(mktemp)"
    n=$(awk '$1=="auth" || $1=="-auth" {print NR; exit}' "$file")
    if [ "${n:-0}" -gt 0 ]; then
        awk -v n="$n" -v line="auth optional ${PAM_NAME}.so" \
            'NR==n{print line; print; next} {print}' "$file" > "$tmp"
    else
        { printf 'auth optional %s.so\n' "$PAM_NAME"; cat "$file"; } > "$tmp"
    fi
    printf '\n%s\n' "$MARKER" >> "$tmp"
    chmod --reference="$file" "$tmp" 2>/dev/null || chmod 0644 "$tmp"
    mv "$tmp" "$file"
}

# Какой режим для сервиса? (echo "single" или "multi")
mode_for_service() {
    case " $SINGLE_PROMPT_SERVICES " in
        *" $1 "*) echo single ;;
        *)        echo multi  ;;
    esac
}

enable_one() {
    src="$1"
    name=$(basename "$src")

    if [ "${src#$VENDOR_PAM}" != "$src" ]; then
        # vendor-файл из пакета: создаём override в /etc/pam.d
        target="$ETC_PAM/$name"
        mode=$(mode_for_service "$name")
        if [ -f "$target" ]; then
            if grep -q "$MARKER" "$target" 2>/dev/null; then
                # наш прошлый override — регенерируем из актуального vendor-файла
                cp "$src" "$target.new"
                if [ "$mode" = single ]; then
                    insert_before_first_auth "$target.new"
                else
                    insert_after_last_auth "$target.new"
                fi
                chmod --reference="$target" "$target.new" 2>/dev/null || chmod 0644 "$target.new"
                mv "$target.new" "$target"
                ok "override обновлён ($mode): $target (из актуального $src)"
            else
                warn "$target уже существует и не наш — применим вставку строки"
                line_exists "$target" || insert_after_last_auth "$target" nomarker
                ok "строка добавлена: $target"
            fi
            return 0
        fi
        install -m 0644 "$src" "$target"
        if [ "$mode" = single ]; then
            insert_before_first_auth "$target"
        else
            insert_after_last_auth "$target"
        fi
        ok "создан override ($mode): $target (копия $src + строка)"
        warn "после обновления пакета '$name' перезапустите: pam-math-challenge refresh"
        return 0
    fi

    # файл прямо в /etc/pam.d — правим с бэкапом, БЕЗ маркера
    if line_exists "$src"; then
        ok "уже активен: $src"
        return 0
    fi
    BACKUP="${src}.pammath.bak"
    [ -f "$BACKUP" ] || cp -a "$src" "$BACKUP"
    insert_after_last_auth "$src" nomarker
    ok "строка добавлена: $src (бэкап: $BACKUP)"
}

enable_module() {
    need_root enable
    [ -f "$ETC_PAM/lightdm" ] || [ -f "$VENDOR_PAM/plasmalogin" ] \
        || warn "ни lightdm, ни plasmalogin не найдены — возможно, у вас другой DM"

    for f in $(find_service_files); do enable_one "$f"; done

    msg ""
    msg "Перезапуск display manager применит изменения немедленно:"
    msg "    pam-math-challenge restart    (СБРОСИТ ТЕКУЩУЮ X/WAYLAND-СЕССИЮ!)"
    msg "или просто разлогиньтесь/заблокируйте экран."
}

disable_module() {
    need_root disable
    for f in $ETC_PAM/*; do
        [ -f "$f" ] || continue
        if grep -q "$MARKER" "$f" 2>/dev/null; then
            # это наш генерируемый override: если существует vendor-файл,
            # полностью удаляем override (вернётся пакетный файл)
            name=$(basename "$f")
            if [ -f "$VENDOR_PAM/$name" ]; then
                rm -f "$f"
                ok "override удалён (вернулось к vendor-файлу): $f"
            else
                sed -i "/^auth optional ${PAM_NAME}\.so/d" "$f"
                sed -i "/${MARKER}/d" "$f"
                ok "override очищен (vendor-файла нет, файл оставлен): $f"
            fi
        fi
    done
    # плюс удаляем строку из любых обычных файлов /etc/pam.d (без маркера)
    for f in $ETC_PAM/*; do
        [ -f "$f" ] || continue
        if line_exists "$f"; then
            sed -i "/^[[:space:]]*[-a]*auth[[:space:]]\{1,\}optional[[:space:]]\{1,\}${PAM_NAME}\.so/d" "$f"
            ok "строка удалена: $f"
        fi
    done
}

refresh_module() {
    need_root refresh
    for f in $(find_service_files); do
        case "$f" in "$VENDOR_PAM"/*) enable_one "$f";; esac
    done
}

show_status() {
    msg "module   : $(find_lib_dir 2>/dev/null)"
    for f in $(find_service_files); do
        if line_exists "$f"; then
            msg "  активен   : $f"
        else
            msg "  не активн.: $f"
        fi
    done
    if [ -f "$CONF_PATH" ]; then
        msg "config   : $CONF_PATH"
    else
        msg "config   : НЕ УСТАНОВЛЕН — модуль сработает в fail-open (PAM_IGNORE)"
    fi
}

find_lib_dir() {
    for d in /usr/lib/x86_64-linux-gnu/security /usr/lib/security; do
        [ -f "$d/${PAM_NAME}.so" ] && echo "installed: $d/${PAM_NAME}.so" && return 0
    done
    echo "not installed" && return 1
}

detect_dm() {
    if systemctl is-active plasmalogin >/dev/null 2>&1; then echo plasmalogin
    elif systemctl is-active lightdm >/dev/null 2>&1; then echo lightdm
    else echo "не определён"; fi
}

restart_lightdm() {
    need_root restart
    dm=$(detect_dm)
    warn "ПЕРЕЗАПУСК УБЬЁТ ТЕКУЩУЮ ГРАФИЧЕСКУЮ СЕССИЮ! Откройте tty/ssh заранее."
    sleep 3
    case "$dm" in
        plasmalogin) systemctl restart plasmalogin ;;
        lightdm)     systemctl restart lightdm ;;
        *) die "display manager не определён, перезапустите вручную" ;;
    esac
}

case "${1:-status}" in
    enable)   enable_module ;;
    disable)  disable_module ;;
    refresh)  refresh_module ;;
    status)   show_status ;;
    restart)  restart_lightdm ;;
    *)        die "использование: $0 {enable|disable|refresh|status|restart}" ;;
esac
